# Copy to .env.local for development. On Vercel, set these in Project Settings.

# Postgres. Locally: `npm run db:up` starts one on port 5434.
# On Vercel, the Neon integration sets DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct, used for migrations) for you.
DATABASE_URL="postgresql://polaris:polaris@localhost:5434/polaris"
DATABASE_URL_UNPOOLED=""

# Better Auth. Generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Stripe (test mode keys are fine). The webhook secret comes from the
# endpoint in the Stripe dashboard, or from `stripe listen` locally.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# S3 bucket for images that sellers upload. Objects must be publicly readable.
AWS_S3_REGION=""
AWS_S3_BUCKET_NAME=""
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""

# Optional: the seed creates this admin account if both are set.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
