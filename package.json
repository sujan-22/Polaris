{
    "name": "polaris",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "postinstall": "prisma generate",
        "vercel-build": "prisma generate && prisma migrate deploy && prisma db seed && next build",
        "db:up": "docker compose up -d --wait",
        "db:migrate": "prisma migrate dev",
        "db:seed": "prisma db seed",
        "db:reset": "prisma migrate reset --force",
        "db:studio": "prisma studio",
        "make-admin": "tsx scripts/make-admin.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1147.0",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "@vercel/analytics": "^2.0.1",
        "better-auth": "^1.7.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.52.0",
        "motion": "^14.0.0",
        "next": "^16.4.0",
        "radix-ui": "^1.7.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "server-only": "^0.0.1",
        "sonner": "^2.0.8",
        "stripe": "^23.0.0",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "dotenv": "^18.0.6",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.4.0",
        "prisma": "^7.10.0",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.3"
    }
}
